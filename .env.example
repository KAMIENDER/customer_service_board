# 前端本地开发时可用
VITE_KB_PROXY_BASE_URL=

# 代理服务
PORT=38888
CORS_ORIGIN=http://localhost:3000

# 火山 OpenAPI
VOLC_ACCESS_KEY_ID=
VOLC_SECRET_KEY=
VOLC_REGION=cn-beijing
VOLC_OPENAPI_SERVICE=air
VOLC_OPENAPI_BASE_URL=https://open.volcengineapi.com
VOLC_KNOWLEDGE_BASE_URL=https://api-knowledgebase.mlp.cn-beijing.volces.com
VOLC_DEFAULT_KB_RESOURCE_ID=
VOLC_DEFAULT_KB_COLLECTION_NAME=
VOLC_DEFAULT_KB_PROJECT=default

# 调试开关：仅本地排查签名时开启
ENABLE_VOLC_SIGN_DEBUG=0

# 上传文件导入时需要对外可访问的地址
PUBLIC_BASE_URL=

# 上传限制
UPLOAD_FILE_MAX_SIZE=20971520
UPLOAD_FILE_MAX_COUNT=10
